---
import { skillStrata } from "../data/resume";

type LayerNode = {
  id: string;
  depth: string;
  layer: string;
  items: string[];
  x: number;
  y: number;
};

const LAYERS: LayerNode[] = [
  { id: "lang", depth: "01", layer: "Languages", items: skillStrata[0].items, x: 20, y: 16 },
  { id: "found", depth: "02", layer: "Foundations", items: skillStrata[1].items, x: 13, y: 58 },
  { id: "aiml", depth: "03", layer: "AI / ML", items: skillStrata[2].items, x: 79, y: 18 },
  { id: "web", depth: "04", layer: "Web", items: skillStrata[3].items, x: 82, y: 62 },
  { id: "tool", depth: "05", layer: "Tooling", items: skillStrata[4].items, x: 44, y: 87 },
];

const HUB = { x: 49, y: 45 };

const edgePath = (n: LayerNode) => {
  const dy = (n.y - HUB.y) * 0.45;
  return `M ${HUB.x} ${HUB.y} C ${HUB.x} ${HUB.y + dy}, ${n.x} ${n.y - dy}, ${n.x} ${n.y}`;
};
---

<section id="stack" class="section section--wide">
  <p class="eyebrow" data-reveal>stack.json</p>
  <h2 class="section-title" data-reveal style="--reveal-delay: 70ms;">What everything above is built from.</h2>

  <div class="graph-wrap" data-reveal style="--reveal-delay: 140ms;">
    <svg class="graph-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {
        LAYERS.map((l) => (
          <path
            class="edge"
            data-layer={l.id}
            d={edgePath(l)}
            vector-effect="non-scaling-stroke"
          />
        ))
      }
    </svg>

    <div class="hub" aria-hidden="true">
      <span class="hub-cube">
        <span class="f top"></span><span class="f left"></span><span class="f right"></span>
      </span>
      <span class="hub-label mono">~/stack</span>
    </div>

    {
      LAYERS.map((l) => (
        <article class="layer-card" data-layer={l.id} style={`left:${l.x}%; top:${l.y}%;`}>
          <header class="layer-head">
            <span class="depth mono">{l.depth}</span>
            <h3 class="layer-name">{l.layer}</h3>
          </header>
          <ul class="layer-items">
            {l.items.map((item) => (
              <li class="item mono">{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="layer-fallback">
    {
      LAYERS.map((l) => (
        <div class="fallback-card" data-reveal>
          <header class="layer-head">
            <span class="depth mono">{l.depth}</span>
            <h3 class="layer-name">{l.layer}</h3>
          </header>
          <ul class="layer-items">
            {l.items.map((item) => (
              <li class="item mono">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .graph-wrap {
    position: relative;
    min-height: 640px;
  }

  @media (max-width: 900px) {
    .graph-wrap {
      display: none;
    }
    .layer-fallback {
      display: flex;
    }
  }

  .layer-fallback {
    display: none;
    flex-direction: column;
    gap: 10px;
  }

  .graph-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .edge {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 4 5;
    transition: stroke 220ms ease;
  }

  .edge.lit {
    stroke: var(--gold);
    animation: edge-flow 1.1s linear infinite;
  }

  @keyframes edge-flow {
    to {
      stroke-dashoffset: -18;
    }
  }

  .hub {
    position: absolute;
    left: 49%;
    top: 45%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px 22px;
    background: var(--surface-2);
    border: 1px solid var(--gold-dim);
    border-radius: var(--radius);
    box-shadow: 0 18px 44px -24px rgba(0, 0, 0, 0.75);
    z-index: 2;
  }

  .hub-cube {
    position: relative;
    width: 18px;
    height: 18px;
    transform: translateY(3px);
  }

  .hub-cube .f {
    position: absolute;
    width: 18px;
    height: 18px;
  }
  .hub-cube .top {
    background: var(--gold);
    transform: rotate(30deg) skewX(-30deg) scaleY(0.864);
    top: -7.5px;
  }
  .hub-cube .left {
    background: var(--gold-dim);
    transform: skewY(-30deg);
    top: 0.5px;
  }
  .hub-cube .right {
    background: #4a3a1e;
    transform: scaleX(-1) skewY(-30deg);
    top: 0.5px;
  }

  .hub-label {
    font-size: 12px;
    color: var(--text);
    letter-spacing: 0.03em;
  }

  .layer-card {
    position: absolute;
    transform: translate(-50%, -50%);
    max-width: 240px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    z-index: 1;
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      opacity 700ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .layer-card:hover,
  .layer-card.lit {
    border-color: var(--gold-dim);
    box-shadow: 0 20px 40px -26px rgba(0, 0, 0, 0.75);
  }

  .layer-head {
    display: flex;
    align-items: baseline;
    gap: 9px;
    margin-bottom: 10px;
  }

  .depth {
    font-size: 11.5px;
    color: var(--gold-dim);
  }

  .layer-name {
    font-family: var(--font-display);
    font-size: 14.5px;
    color: var(--text);
  }

  .layer-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
  }

  .item {
    font-size: 11.5px;
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: 3px;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .layer-card:hover .item {
    color: var(--text);
  }

  .fallback-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
  }

  @media (max-width: 900px) {
    .graph-wrap + * {
      margin-top: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".layer-card").forEach((card) => {
    const id = card.dataset.layer;
    if (!id) return;
    const edge = document.querySelector<SVGPathElement>(`.edge[data-layer="${id}"]`);
    card.addEventListener("pointerenter", () => edge?.classList.add("lit"));
    card.addEventListener("pointerleave", () => edge?.classList.remove("lit"));
  });
</script>
