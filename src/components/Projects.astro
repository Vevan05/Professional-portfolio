---
import { projects } from "../data/resume";
---

<section id="projects" class="section section--wide">
  <p class="eyebrow" data-reveal>projects/</p>
  <h2 class="section-title" data-reveal style="--reveal-delay: 70ms;">Shipped, not just scoped.</h2>

  <div class="modules">
    {
      projects.map((p, i) => (
        <article class="module" data-reveal style={`--reveal-delay: ${(i % 2) * 90}ms;`}>
          <div class="module-card">
            <div class="module-body">
              <div class="module-head">
                <span class="module-index mono">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="module-name">
                    <a href={p.href} target="_blank" rel="noopener noreferrer">
                      {p.name}
                    </a>
                  </h3>
                  <p class="module-tagline">{p.tagline}</p>
                </div>
              </div>

              <ul class="module-bullets">
                {p.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>

            <div class="glyph-col" aria-hidden="true">
              <span class="module-status mono">{p.status}</span>
              <div class="glyph-mount" data-glyph={p.id}></div>
            </div>
          </div>

          <div class="module-stack">
            {p.stack.map((s) => (
              <span class="tag mono">{s}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .modules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
    align-items: start;
  }

  @media (min-width: 861px) {
    .module:nth-child(even) {
      margin-top: 84px;
    }
  }

  @media (max-width: 860px) {
    .modules {
      grid-template-columns: 1fr;
    }
  }

  .module {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: 28px;
  }

  @media (max-width: 640px) {
    .module {
      padding: 22px 18px;
    }
  }

  .module-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(132px, 42%, 188px);
    gap: 22px;
    align-items: center;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 140ms ease-out;
    will-change: transform;
  }

  .module-card::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: radial-gradient(
      380px circle at var(--gx, 50%) var(--gy, 50%),
      rgba(217, 164, 65, 0.08),
      transparent 46%
    );
    opacity: 0;
    transition: opacity 220ms ease;
    pointer-events: none;
  }

  .module:hover {
    border-color: var(--border);
    box-shadow: 0 24px 48px -30px rgba(0, 0, 0, 0.65);
  }

  .module:hover .module-card::after {
    opacity: 1;
  }

  .glyph-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .glyph-mount {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    transform: translateZ(0);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 52%, transparent 76%);
    mask-image: radial-gradient(circle at 50% 50%, black 52%, transparent 76%);
  }

  .glyph-mount :global(canvas) {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .module-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 14px;
    margin-bottom: 16px;
  }

  .module-index {
    font-size: 13px;
    color: var(--gold-dim);
    padding-top: 4px;
  }

  .module-name {
    font-size: 20px;
  }

  .module-name a {
    transition: color 150ms ease;
  }
  .module-name a:hover {
    color: var(--gold);
  }

  .module-tagline {
    color: var(--text-dim);
    font-size: 14px;
    margin-top: 4px;
  }

  .module-status {
    font-size: 11px;
    color: var(--teal);
    background: var(--teal-dim);
    padding: 4px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .module-bullets {
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .module-bullets li {
    position: relative;
    padding-left: 18px;
    color: var(--text-dim);
    font-size: 14.5px;
    line-height: 1.65;
  }

  .module-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    background: var(--border);
    border-radius: 1px;
    transform: rotate(45deg);
  }

  .module-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .tag {
    font-size: 11.5px;
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 4px 9px;
    border-radius: 3px;
  }
</style>

<script>
  import * as THREE from "three";

  const finePointer = window.matchMedia("(pointer: fine)").matches;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".module-card").forEach((card) => {
    if (!finePointer || reduced) return;
    card.addEventListener("pointermove", (e) => {
      const rect = card.getBoundingClientRect();
      const px = (e.clientX - rect.left) / rect.width;
      const py = (e.clientY - rect.top) / rect.height;
      card.style.setProperty("--ry", `${(px - 0.5) * 5}deg`);
      card.style.setProperty("--rx", `${(0.5 - py) * 5}deg`);
      card.style.setProperty("--gx", `${px * 100}%`);
      card.style.setProperty("--gy", `${py * 100}%`);
    });
    card.addEventListener("pointerleave", () => {
      card.style.setProperty("--rx", "0deg");
      card.style.setProperty("--ry", "0deg");
    });
  });

  type Vox = { x: number; y: number; z: number; hex: number };

  function mulberry32(seed: number) {
    return () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const vr = mulberry32(4242);
  const rcA = new THREE.Color();
  const rcB = new THREE.Color();
  const ramp = (a: string, b: string, t: number, jitter = 0) => {
    const n = 1 - vr() * jitter;
    return rcA.set(a).lerp(rcB.set(b), Math.min(1, Math.max(0, t))).multiplyScalar(n).getHex();
  };

  const STEEL_A = "#20262e";
  const STEEL_B = "#4a5563";
  const GOLD_A = "#8a6a30";
  const GOLD_B = "#dfa94a";
  const TEAL_A = "#27423d";
  const TEAL_B = "#67b7aa";

  function genContainers(): Vox[] {
    const out: Vox[] = [];
    const box = (
      cx: number,
      cy: number,
      cz: number,
      a: string,
      b: string
    ) => {
      for (let dx = -2; dx <= 2; dx++) {
        for (let dy = 0; dy <= 1; dy++) {
          for (let dz = -1; dz <= 1; dz++) {
            out.push({
              x: cx + dx * 1.02,
              y: cy + dy * 1.02,
              z: cz + dz * 1.02,
              hex: ramp(a, b, dy / 2 + ((dz + 1) / 3) * 0.6, 0.12),
            });
          }
        }
      }
    };
    box(-3.2, -3.2, 0, STEEL_A, STEEL_B);
    box(3.2, -3.2, 0, TEAL_A, TEAL_B);
    box(0, -0.7, 0, GOLD_A, GOLD_B);
    return out;
  }

  function genBot(): Vox[] {
    const out: Vox[] = [];
    const put = (x: number, y: number, hex: number) => {
      out.push({ x, y, z: 0.55, hex });
      out.push({ x, y, z: -0.55, hex });
    };
    for (let x = -3; x <= 3; x++) {
      put(x, 2, ramp(STEEL_A, STEEL_B, 1, 0.12));
      put(x, -2, ramp(STEEL_A, STEEL_B, 0, 0.12));
    }
    for (let y = -1; y <= 1; y++) {
      put(-3, y, ramp(STEEL_A, STEEL_B, (y + 2) / 5, 0.12));
      put(3, y, ramp(STEEL_A, STEEL_B, (y + 2) / 5, 0.12));
      put(-4, y, ramp(GOLD_A, GOLD_B, 0.4, 0.05));
      put(4, y, ramp(GOLD_A, GOLD_B, 0.4, 0.05));
    }
    put(-2, 0.5, ramp(TEAL_A, TEAL_B, 0.95, 0.03));
    put(-1, 0.5, ramp(TEAL_A, TEAL_B, 0.95, 0.03));
    put(1, 0.5, ramp(TEAL_A, TEAL_B, 0.95, 0.03));
    put(2, 0.5, ramp(TEAL_A, TEAL_B, 0.95, 0.03));
    for (let x = -2; x <= 2; x++) {
      put(x, -1, ramp(GOLD_A, GOLD_B, 0.7, 0.04));
    }
    put(0, 3, ramp(STEEL_A, STEEL_B, 0.8, 0.08));
    put(0, 4.2, ramp(GOLD_A, GOLD_B, 1, 0.03));
    return out;
  }

  function genLeaf(): Vox[] {
    const out: Vox[] = [];
    const rows: [number, number[]][] = [
      [4, [0]],
      [3, [-1, 0, 1]],
      [2, [-2, -1, 0, 1, 2]],
      [1, [-3, -2, -1, 0, 1, 2, 3]],
      [0, [-3, -2, -1, 0, 1, 2, 3]],
      [-1, [-2, -1, 0, 1, 2]],
      [-2, [-1, 0, 1]],
      [-3, [0]],
    ];
    const spots = new Set(["2,1", "-2,0", "1,-2"]);
    rows.forEach(([y, xs], ri) => {
      xs.forEach((x) => {
        const shade = ri / (rows.length - 1);
        const key = `${x},${y}`;
        if (spots.has(key)) {
          const hex = ramp("#a35f24", GOLD_B, 0.75, 0.05);
          out.push({ x, y, z: 0.62, hex });
          return;
        }
        const vein = x === 0 || (Math.abs(y) === 1 && Math.abs(x) === 2);
        const front = vein
          ? ramp("#3d7c68", "#82cbb8", shade, 0.04)
          : ramp(TEAL_A, TEAL_B, shade, 0.14);
        out.push({ x, y, z: 0.55, hex: front });
        out.push({
          x,
          y,
          z: -0.55,
          hex: ramp("#16302b", TEAL_A, shade, 0.1),
        });
      });
    });
    out.push({ x: 0, y: -4, z: 0, hex: ramp(GOLD_A, GOLD_B, 0.35, 0.04) });
    out.push({ x: 0, y: -5, z: 0, hex: ramp(GOLD_A, GOLD_B, 0.25, 0.04) });
    return out;
  }

  function genFace(): Vox[] {
    const out: Vox[] = [];
    const R = 4.6;
    for (let x = -6; x <= 6; x++) {
      for (let y = -6; y <= 6; y++) {
        const d = Math.hypot(x, y);
        if (Math.abs(d - R) < 0.72) {
          out.push({
            x,
            y,
            z: 0.55,
            hex: ramp(STEEL_A, STEEL_B, (y + R) / (2 * R), 0.12),
          });
          out.push({
            x,
            y,
            z: -0.55,
            hex: ramp(STEEL_A, "#171b21", (y + R) / (2 * R), 0.1),
          });
        } else if (d < R - 0.7) {
          const eyeL = Math.abs(x + 1.9) < 0.7 && Math.abs(y - 1.3) < 1.15;
          const eyeR = Math.abs(x - 1.9) < 0.7 && Math.abs(y - 1.3) < 1.15;
          const mouth = y < -0.8 && Math.abs(d - 2.55) < 0.62;
          if (eyeL || eyeR) {
            out.push({ x, y, z: 0.6, hex: ramp(TEAL_A, TEAL_B, 0.9, 0.04) });
          } else if (mouth) {
            out.push({ x, y, z: 0.6, hex: ramp(GOLD_A, GOLD_B, 0.75, 0.04) });
          }
        }
      }
    }
    return out;
  }

  const generators: Record<string, () => Vox[]> = {
    vync: genContainers,
    "10kwery": genBot,
    "leaf-disease": genLeaf,
    "emotion-detector": genFace,
  };

  function mountGlyph(el: HTMLElement, vox: Vox[]) {
    try {
      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setClearColor(0x000000, 0);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;

      let cx = 0,
        cy = 0,
        cz = 0;
      vox.forEach((v) => {
        cx += v.x;
        cy += v.y;
        cz += v.z;
      });
      cx /= vox.length;
      cy /= vox.length;
      cz /= vox.length;
      let maxR = 1;
      vox.forEach((v) => {
        maxR = Math.max(maxR, Math.hypot(v.x - cx, v.y - cy, v.z - cz));
      });

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
      const dist = maxR * 2.45;

      scene.add(new THREE.AmbientLight(0xc2cad6, 0.9));
      const keyLight = new THREE.DirectionalLight(0xffd9a3, 2.4);
      keyLight.position.set(6, 9, 7);
      scene.add(keyLight);
      const rimLight = new THREE.DirectionalLight(0x66d0c2, 1.5);
      rimLight.position.set(-7, 2, -6);
      scene.add(rimLight);

      const cluster = new THREE.Group();
      cluster.position.set(-cx, -cy, -cz);
      scene.add(cluster);

      const geometry = new THREE.BoxGeometry(0.94, 0.94, 0.94);
      const material = new THREE.MeshStandardMaterial({ roughness: 0.8, metalness: 0.08 });
      const mesh = new THREE.InstancedMesh(geometry, material, vox.length);
      const dummy = new THREE.Object3D();
      const col = new THREE.Color();
      vox.forEach((v, i) => {
        dummy.position.set(v.x, v.y, v.z);
        dummy.updateMatrix();
        mesh.setMatrixAt(i, dummy.matrix);
        mesh.setColorAt(i, col.setHex(v.hex));
      });
      if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
      cluster.add(mesh);
      el.appendChild(renderer.domElement);

      const placeCamera = () => {
        camera.aspect = (el.clientWidth || 1) / (el.clientHeight || 1);
        camera.updateProjectionMatrix();
        const elev = 0.5;
        const horiz = Math.cos(elev) * dist;
        camera.position.set(
          Math.sin(0.6) * horiz,
          Math.sin(elev) * dist,
          Math.cos(0.6) * horiz
        );
        camera.lookAt(0, 0, 0);
      };

      let lastW = -1;
      let lastH = -1;

      const layout = () => {
        const w = el.clientWidth || 1;
        const h = el.clientHeight || 1;
        if (w === lastW && h === lastH) return;
        lastW = w;
        lastH = h;
        renderer.setSize(w, h, false);
        if (reduced) drawFrame(performance.now());
      };

      function drawFrame(now: number) {
        const t = now / 1000;
        if (reduced) {
          cluster.rotation.set(0, 0, 0);
          cluster.position.set(-cx, -cy, -cz);
        } else {
          cluster.rotation.y = Math.sin(t * 0.34) * 0.48;
          cluster.rotation.x = Math.sin(t * 0.21 + 1.1) * 0.07;
          cluster.position.set(-cx, -cy + Math.sin(t * 0.6) * 0.24, -cz);
        }
        placeCamera();
        renderer.render(scene, camera);
      }

      let inView = false;
      let rafId = 0;
      const frame = (now: number) => {
        drawFrame(now);
        rafId = requestAnimationFrame(frame);
      };
      new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry) return;
          if (entry.isIntersecting && !inView && !reduced) {
            rafId = requestAnimationFrame(frame);
          } else if (!entry.isIntersecting && inView && !reduced) {
            cancelAnimationFrame(rafId);
          }
          inView = entry.isIntersecting;
        },
        { threshold: 0.05 }
      ).observe(el);

      const ro = new ResizeObserver(() => layout());
      ro.observe(el);

      layout();
      drawFrame(performance.now());
    } catch {
      el.remove();
    }
  }

  document.querySelectorAll<HTMLElement>(".glyph-mount").forEach((el) => {
    const id = el.dataset.glyph ?? "";
    const gen = generators[id];
    if (!gen) return;
    mountGlyph(el, gen());
  });
</script>
