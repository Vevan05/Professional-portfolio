---
import { projects } from "../data/resume";
---

<section id="projects" class="section section--wide">
  <p class="eyebrow" data-reveal>projects/</p>
  <h2 class="section-title" data-reveal style="--reveal-delay: 70ms;">Shipped, not just scoped.</h2>

  <div class="modules">
    {
      projects.map((p, i) => (
        <article class:list={["module", p.featured && "module--featured"]} data-reveal style={`--reveal-delay: ${(i % 2) * 90}ms;`}>
          <div class="module-card">
            <div class="module-body">
              <div class="module-head">
                <span class="module-index mono">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3 class="module-name">
                    <a href={p.href} target="_blank" rel="noopener noreferrer">
                      {p.name}
                    </a>
                  </h3>
                  <p class="module-tagline">{p.tagline}</p>
                  {p.demo && (
                    <a class="module-demo mono" href={p.demo} target="_blank" rel="noopener noreferrer">live demo ↗</a>
                  )}
                </div>
              </div>

              <ul class="module-bullets">
                {p.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>

            <div class="glyph-col" aria-hidden="true">
              <span class="module-status mono">{p.status}</span>
              <div class="glyph-mount" data-glyph={p.id}></div>
            </div>
          </div>

          <div class="module-stack">
            {p.stack.map((s) => (
              <span class="tag mono">{s}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .modules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
    align-items: stretch;
  }

  .module--featured {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(100%, 680px);
  }

  @media (max-width: 860px) {
    .modules {
      grid-template-columns: 1fr;
    }
  }

  .module {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: 28px;
  }

  @media (max-width: 640px) {
    .module {
      padding: 20px 16px;
    }
  }

  @media (max-width: 380px) {
    .module {
      padding: 16px 12px;
    }
  }

  .module-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(116px, 28%, 156px);
    gap: 22px;
    align-items: center;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 140ms ease-out;
    will-change: transform;
  }

  @media (max-width: 600px) {
    .module-card {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .glyph-col {
      order: -1;
      flex-direction: row;
      justify-content: space-between;
      width: 100%;
    }
    .glyph-mount {
      width: 96px;
      max-width: 38%;
      margin-left: auto;
    }
  }

  @media (max-width: 380px) {
    .module-card {
      gap: 12px;
    }
    .glyph-mount {
      width: 80px;
    }
  }

  @media (pointer: coarse) {
    .module-card {
      transform: none !important;
    }
  }

  .module-card::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: radial-gradient(
      380px circle at var(--gx, 50%) var(--gy, 50%),
      rgba(217, 164, 65, 0.08),
      transparent 46%
    );
    opacity: 0;
    transition: opacity 220ms ease;
    pointer-events: none;
  }

  .module:hover {
    border-color: var(--border);
    box-shadow: 0 24px 48px -30px rgba(0, 0, 0, 0.65);
  }

  .module:hover .module-card::after {
    opacity: 1;
  }

  .module.module--featured {
    border-color: rgba(167, 139, 250, 0.4);
    box-shadow: 0 0 0 1px rgba(167, 139, 250, 0.1), 0 30px 60px -36px rgba(167, 139, 250, 0.45);
  }

  .module.module--featured:hover {
    border-color: rgba(167, 139, 250, 0.7);
  }

  .module--featured .module-card::after {
    background: radial-gradient(380px circle at var(--gx, 50%) var(--gy, 50%), rgba(167, 139, 250, 0.1), transparent 46%);
  }

  .module--featured .module-index,
  .module--featured .module-name a:hover {
    color: #a78bfa;
  }

  .module--featured .module-status {
    color: #a78bfa;
    background: rgba(167, 139, 250, 0.14);
  }

  .glyph-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .glyph-mount {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    transform: translateZ(0);
    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 52%, transparent 76%);
    mask-image: radial-gradient(circle at 50% 50%, black 52%, transparent 76%);
  }

  .glyph-mount :global(canvas) {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .module-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 14px;
    margin-bottom: 16px;
  }

  .module-index {
    font-size: 13px;
    color: var(--gold-dim);
    padding-top: 4px;
  }

  .module-name {
    font-size: clamp(18px, 4.2vw, 20px);
    overflow-wrap: break-word;
  }

  .module-name a {
    transition: color 150ms ease;
  }
  .module-name a:hover {
    color: var(--gold);
  }

  .module-tagline {
    color: var(--text-dim);
    font-size: clamp(12.5px, 2.8vw, 14px);
    margin-top: 4px;
    overflow-wrap: break-word;
  }

  .module-demo {
    display: inline-block;
    margin-top: 6px;
    font-size: 11px;
    color: var(--teal);
    transition: color 150ms ease;
  }

  .module-demo:hover {
    color: var(--gold);
  }

  .module-status {
    font-size: 11px;
    color: var(--teal);
    background: var(--teal-dim);
    padding: 4px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .module-bullets {
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .module-bullets li {
    position: relative;
    padding-left: 18px;
    color: var(--text-dim);
    font-size: clamp(13px, 2.9vw, 14.5px);
    line-height: 1.65;
    overflow-wrap: break-word;
  }

  .module-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    background: var(--border);
    border-radius: 1px;
    transform: rotate(45deg);
  }

  .module-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 20px;
  }

  .tag {
    font-size: clamp(10.5px, 2.4vw, 11.5px);
    color: var(--text-dim);
    border: 1px solid var(--border);
    padding: 4px 8px;
    border-radius: 3px;
    overflow-wrap: break-word;
  }
</style>

<script>
  import * as THREE from "three";

  const finePointer = window.matchMedia("(pointer: fine)").matches;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".module-card").forEach((card) => {
    if (!finePointer || reduced) return;
    card.addEventListener("pointermove", (e) => {
      const rect = card.getBoundingClientRect();
      const px = (e.clientX - rect.left) / rect.width;
      const py = (e.clientY - rect.top) / rect.height;
      card.style.setProperty("--ry", `${(px - 0.5) * 5}deg`);
      card.style.setProperty("--rx", `${(0.5 - py) * 5}deg`);
      card.style.setProperty("--gx", `${px * 100}%`);
      card.style.setProperty("--gy", `${py * 100}%`);
    });
    card.addEventListener("pointerleave", () => {
      card.style.setProperty("--rx", "0deg");
      card.style.setProperty("--ry", "0deg");
    });
  });

  type Vox = { x: number; y: number; z: number; hex: number };

  function mulberry32(seed: number) {
    return () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const vr = mulberry32(4242);
  const rcA = new THREE.Color();
  const rcB = new THREE.Color();
  const ramp = (a: string, b: string, t: number, jitter = 0) => {
    const n = 1 - vr() * jitter;
    return rcA.set(a).lerp(rcB.set(b), Math.min(1, Math.max(0, t))).multiplyScalar(n).getHex();
  };

  const STEEL_A = "#20262e";
  const STEEL_B = "#4a5563";
  const GOLD_A = "#8a6a30";
  const GOLD_B = "#dfa94a";
  const TEAL_A = "#27423d";
  const TEAL_B = "#67b7aa";

  function genContainers(): Vox[] {
    const out: Vox[] = [];
    const box = (
      cx: number,
      cy: number,
      cz: number,
      a: string,
      b: string
    ) => {
      for (let dx = -2; dx <= 2; dx++) {
        for (let dy = 0; dy <= 1; dy++) {
          for (let dz = -1; dz <= 1; dz++) {
            out.push({
              x: cx + dx * 1.02,
              y: cy + dy * 1.02,
              z: cz + dz * 1.02,
              hex: ramp(a, b, dy / 2 + ((dz + 1) / 3) * 0.6, 0.12),
            });
          }
        }
      }
    };
    box(-3.2, -3.2, 0, STEEL_A, STEEL_B);
    box(3.2, -3.2, 0, TEAL_A, TEAL_B);
    box(0, -0.7, 0, GOLD_A, GOLD_B);
    return out;
  }

  function genBot(): Vox[] {
    const out: Vox[] = [];
    const put = (x: number, y: number, hex: number) => {
      out.push({ x, y, z: 0.55, hex });
      out.push({ x, y, z: -0.55, hex });
    };
    for (let x = -3; x <= 3; x++) {
      put(x, 2, ramp(STEEL_A, STEEL_B, 1, 0.12));
      put(x, -2, ramp(STEEL_A, STEEL_B, 0, 0.12));
    }
    for (let y = -1; y <= 1; y++) {
      put(-3, y, ramp(STEEL_A, STEEL_B, (y + 2) / 5, 0.12));
      put(3, y, ramp(STEEL_A, STEEL_B, (y + 2) / 5, 0.12));
      put(-4, y, ramp(GOLD_A, GOLD_B, 0.4, 0.05));
      put(4, y, ramp(GOLD_A, GOLD_B, 0.4, 0.05));
    }
    put(-2, 0.5, ramp(TEAL_A, TEAL_B, 0.95, 0.03));
    put(-1, 0.5, ramp(TEAL_A, TEAL_B, 0.95, 0.03));
    put(1, 0.5, ramp(TEAL_A, TEAL_B, 0.95, 0.03));
    put(2, 0.5, ramp(TEAL_A, TEAL_B, 0.95, 0.03));
    for (let x = -2; x <= 2; x++) {
      put(x, -1, ramp(GOLD_A, GOLD_B, 0.7, 0.04));
    }
    put(0, 3, ramp(STEEL_A, STEEL_B, 0.8, 0.08));
    put(0, 4.2, ramp(GOLD_A, GOLD_B, 1, 0.03));
    return out;
  }

  function genLeaf(): Vox[] {
    const out: Vox[] = [];
    const rows: [number, number[]][] = [
      [4, [0]],
      [3, [-1, 0, 1]],
      [2, [-2, -1, 0, 1, 2]],
      [1, [-3, -2, -1, 0, 1, 2, 3]],
      [0, [-3, -2, -1, 0, 1, 2, 3]],
      [-1, [-2, -1, 0, 1, 2]],
      [-2, [-1, 0, 1]],
      [-3, [0]],
    ];
    const spots = new Set(["2,1", "-2,0", "1,-2"]);
    rows.forEach(([y, xs], ri) => {
      xs.forEach((x) => {
        const shade = ri / (rows.length - 1);
        const key = `${x},${y}`;
        if (spots.has(key)) {
          const hex = ramp("#a35f24", GOLD_B, 0.75, 0.05);
          out.push({ x, y, z: 0.62, hex });
          return;
        }
        const vein = x === 0 || (Math.abs(y) === 1 && Math.abs(x) === 2);
        const front = vein
          ? ramp("#3d7c68", "#82cbb8", shade, 0.04)
          : ramp(TEAL_A, TEAL_B, shade, 0.14);
        out.push({ x, y, z: 0.55, hex: front });
        out.push({
          x,
          y,
          z: -0.55,
          hex: ramp("#16302b", TEAL_A, shade, 0.1),
        });
      });
    });
    out.push({ x: 0, y: -4, z: 0, hex: ramp(GOLD_A, GOLD_B, 0.35, 0.04) });
    out.push({ x: 0, y: -5, z: 0, hex: ramp(GOLD_A, GOLD_B, 0.25, 0.04) });
    return out;
  }

  function genFace(): Vox[] {
    const out: Vox[] = [];
    const R = 4.6;
    for (let x = -6; x <= 6; x++) {
      for (let y = -6; y <= 6; y++) {
        const d = Math.hypot(x, y);
        if (Math.abs(d - R) < 0.72) {
          out.push({
            x,
            y,
            z: 0.55,
            hex: ramp(STEEL_A, STEEL_B, (y + R) / (2 * R), 0.12),
          });
          out.push({
            x,
            y,
            z: -0.55,
            hex: ramp(STEEL_A, "#171b21", (y + R) / (2 * R), 0.1),
          });
        } else if (d < R - 0.7) {
          const eyeL = Math.abs(x + 1.9) < 0.7 && Math.abs(y - 1.3) < 1.15;
          const eyeR = Math.abs(x - 1.9) < 0.7 && Math.abs(y - 1.3) < 1.15;
          const mouth = y < -0.8 && Math.abs(d - 2.55) < 0.62;
          if (eyeL || eyeR) {
            out.push({ x, y, z: 0.6, hex: ramp(TEAL_A, TEAL_B, 0.9, 0.04) });
          } else if (mouth) {
            out.push({ x, y, z: 0.6, hex: ramp(GOLD_A, GOLD_B, 0.75, 0.04) });
          }
        }
      }
    }
    return out;
  }

  function pair(out: Vox[], x: number, y: number, a: string, b: string, t: number) {
    out.push({ x, y, z: 0.55, hex: ramp(a, b, t, 0.08) });
    out.push({ x, y, z: -0.55, hex: ramp(a, b, t * 0.6, 0.08) });
  }

  function genSearch(): Vox[] {
    const out: Vox[] = [];
    const cx = -1;
    const cy = 1;
    const R = 4;
    for (let x = -7; x <= 7; x++) {
      for (let y = -6; y <= 8; y++) {
        const d = Math.hypot(x - cx, y - cy);
        if (Math.abs(d - R) < 0.72) {
          out.push({ x, y, z: 0.55, hex: ramp(STEEL_A, STEEL_B, (y + R) / (2 * R), 0.12) });
          out.push({ x, y, z: -0.55, hex: ramp(STEEL_A, "#171b21", (y + R) / (2 * R), 0.1) });
        }
      }
    }
    const hx = cx + R * Math.SQRT1_2;
    const hy = cy - R * Math.SQRT1_2;
    for (let s = 0; s <= 7; s += 0.5) {
      const x = Math.round(hx + s * Math.SQRT1_2);
      const y = Math.round(hy - s * Math.SQRT1_2);
      pair(out, x, y, GOLD_A, GOLD_B, 0.6);
      pair(out, x + 1, y, GOLD_A, GOLD_B, 0.6);
    }
    const nodes: [number, number][] = [[-3, 2], [0, 3], [1, 0], [-2, -1], [-3, 1]];
    const links: [number, number, number, number][] = [
      [-3, 2, 0, 3],
      [0, 3, 1, 0],
      [1, 0, -2, -1],
      [-2, -1, -3, 1],
      [-3, 1, -3, 2],
      [-3, 2, 1, 0],
    ];
    links.forEach(([x0, y0, x1, y1]) => {
      const n = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0));
      for (let i = 1; i < n; i++) {
        out.push({
          x: Math.round(x0 + ((x1 - x0) * i) / n),
          y: Math.round(y0 + ((y1 - y0) * i) / n),
          z: 0,
          hex: ramp(TEAL_A, TEAL_B, 0.6, 0.05),
        });
      }
    });
    nodes.forEach(([x, y]) => pair(out, x, y, TEAL_A, TEAL_B, 1));
    return out;
  }

  function genHarvest(): Vox[] {
    const out: Vox[] = [];
    for (let x = -5; x <= 5; x++) {
      pair(out, x, -4, "#5a4424", GOLD_A, 0.6);
      pair(out, x, -5, "#3a2c18", "#5a4424", 0.6);
    }
    for (let y = -3; y <= 2; y++) {
      pair(out, 0, y, TEAL_A, TEAL_B, 0.5);
    }
    [[-1, 0], [-2, 0], [-2, 1], [-3, 1], [-3, 2]].forEach(([x, y]) => pair(out, x, y, TEAL_A, TEAL_B, 0.8));
    [[1, -1], [2, -1], [2, 0], [3, 0], [3, 1]].forEach(([x, y]) => pair(out, x, y, TEAL_A, TEAL_B, 0.8));
    for (let y = 3; y <= 5; y++) {
      const t = (y - 3) / 4;
      [-1, 0, 1].forEach((x) => pair(out, x, y, GOLD_A, GOLD_B, 0.4 + t * 0.6));
    }
    pair(out, 0, 6, GOLD_A, GOLD_B, 1);
    pair(out, 0, 7, GOLD_A, GOLD_B, 1);
    for (let dx = -2; dx <= 2; dx++) {
      for (let dy = -2; dy <= 2; dy++) {
        if (Math.hypot(dx, dy) <= 2.05) {
          pair(out, -4 + dx, 5 + dy, GOLD_A, GOLD_B, 1);
        }
      }
    }
    return out;
  }

  function genNeural(): Vox[] {
    const out: Vox[] = [];
    const input: [number, number][] = [[-4, -2], [-4, 0], [-4, 2]];
    const hidden: [number, number][] = [[0, -4], [0, -2], [0, 0], [0, 2], [0, 4]];
    const output: [number, number][] = [[4, -1], [4, 1]];
    const link = (a: [number, number], b: [number, number]) => {
      const n = b[0] - a[0];
      for (let i = 1; i < n; i++) {
        out.push({
          x: a[0] + i,
          y: Math.round(a[1] + ((b[1] - a[1]) * i) / n),
          z: 0,
          hex: ramp(STEEL_A, STEEL_B, 0.5, 0.1),
        });
      }
    };
    input.forEach((a) => hidden.forEach((b) => link(a, b)));
    hidden.forEach((a) => output.forEach((b) => link(a, b)));
    input.forEach(([x, y]) => pair(out, x, y, TEAL_A, TEAL_B, 1));
    hidden.forEach(([x, y]) => pair(out, x, y, STEEL_A, STEEL_B, 0.7));
    output.forEach(([x, y]) => pair(out, x, y, GOLD_A, GOLD_B, 1));
    return out;
  }

  const generators: Record<string, () => Vox[]> = {
    vync: genContainers,
    "10kwery": genBot,
    "leaf-disease": genLeaf,
    "emotion-detector": genFace,
    "hybrid-search-engine": genSearch,
    "harvest-hub": genHarvest,
    "machine-learning-repo": genNeural,
  };

  function mountGlyph(el: HTMLElement, vox: Vox[]) {
    try {
      const isMobile = window.innerWidth < 640 || window.matchMedia("(pointer: coarse)").matches;
      const renderer = new THREE.WebGLRenderer({ antialias: !isMobile, alpha: true, powerPreference: isMobile ? "low-power" : "high-performance" });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, isMobile ? 1 : 2));
      renderer.setClearColor(0x000000, 0);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;

      let cx = 0,
        cy = 0,
        cz = 0;
      vox.forEach((v) => {
        cx += v.x;
        cy += v.y;
        cz += v.z;
      });
      cx /= vox.length;
      cy /= vox.length;
      cz /= vox.length;
      let maxR = 1;
      vox.forEach((v) => {
        maxR = Math.max(maxR, Math.hypot(v.x - cx, v.y - cy, v.z - cz));
      });

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 100);
      const dist = maxR * 2.45;

      scene.add(new THREE.AmbientLight(0xc2cad6, 0.9));
      const keyLight = new THREE.DirectionalLight(0xffd9a3, 2.4);
      keyLight.position.set(6, 9, 7);
      scene.add(keyLight);
      const rimLight = new THREE.DirectionalLight(0x66d0c2, 1.5);
      rimLight.position.set(-7, 2, -6);
      scene.add(rimLight);

      const cluster = new THREE.Group();
      cluster.position.set(-cx, -cy, -cz);
      scene.add(cluster);

      const geometry = new THREE.BoxGeometry(0.94, 0.94, 0.94);
      const material = new THREE.MeshStandardMaterial({ roughness: 0.8, metalness: 0.08 });
      const mesh = new THREE.InstancedMesh(geometry, material, vox.length);
      const dummy = new THREE.Object3D();
      const col = new THREE.Color();
      vox.forEach((v, i) => {
        dummy.position.set(v.x, v.y, v.z);
        dummy.updateMatrix();
        mesh.setMatrixAt(i, dummy.matrix);
        mesh.setColorAt(i, col.setHex(v.hex));
      });
      if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
      cluster.add(mesh);
      el.appendChild(renderer.domElement);

      const placeCamera = () => {
        camera.aspect = (el.clientWidth || 1) / (el.clientHeight || 1);
        camera.updateProjectionMatrix();
        const elev = 0.5;
        const horiz = Math.cos(elev) * dist;
        camera.position.set(
          Math.sin(0.6) * horiz,
          Math.sin(elev) * dist,
          Math.cos(0.6) * horiz
        );
        camera.lookAt(0, 0, 0);
      };

      let lastW = -1;
      let lastH = -1;

      const layout = () => {
        const w = el.clientWidth || 1;
        const h = el.clientHeight || 1;
        if (w === lastW && h === lastH) return;
        lastW = w;
        lastH = h;
        renderer.setSize(w, h, false);
        if (reduced) drawFrame(performance.now());
      };

      function drawFrame(now: number) {
        const t = now / 1000;
        if (reduced) {
          cluster.rotation.set(0, 0, 0);
          cluster.position.set(-cx, -cy, -cz);
        } else {
          cluster.rotation.y = Math.sin(t * 0.34) * 0.48;
          cluster.rotation.x = Math.sin(t * 0.21 + 1.1) * 0.07;
          cluster.position.set(-cx, -cy + Math.sin(t * 0.6) * 0.24, -cz);
        }
        placeCamera();
        renderer.render(scene, camera);
      }

      let inView = false;
      let rafId = 0;
      const frame = (now: number) => {
        drawFrame(now);
        rafId = requestAnimationFrame(frame);
      };
      new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry) return;
          if (entry.isIntersecting && !inView && !reduced) {
            rafId = requestAnimationFrame(frame);
          } else if (!entry.isIntersecting && inView && !reduced) {
            cancelAnimationFrame(rafId);
          }
          inView = entry.isIntersecting;
        },
        { threshold: 0.05 }
      ).observe(el);

      const ro = new ResizeObserver(() => layout());
      ro.observe(el);

      layout();
      drawFrame(performance.now());
    } catch {
      el.remove();
    }
  }

  document.querySelectorAll<HTMLElement>(".glyph-mount").forEach((el) => {
    const id = el.dataset.glyph ?? "";
    const gen = generators[id];
    if (!gen) return;
    mountGlyph(el, gen());
  });
</script>
