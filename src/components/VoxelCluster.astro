---
---

<div class="voxel-scene" aria-hidden="true">
  <div class="cluster-mount" id="cluster-mount"></div>
</div>

<style>
  .voxel-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translateZ(0);
    transition: opacity 900ms ease;
    -webkit-mask-image: radial-gradient(
      ellipse 72% 66% at 76% 40%,
      black 0%,
      black 38%,
      transparent 80%
    );
    mask-image: radial-gradient(
      ellipse 72% 66% at 76% 40%,
      black 0%,
      black 38%,
      transparent 80%
    );
  }

  .voxel-scene.ready {
    opacity: 1;
  }

  .cluster-mount {
    position: absolute;
    inset: 0;
  }

  .cluster-mount :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 900px) {
    .voxel-scene {
      -webkit-mask-image: radial-gradient(
        ellipse 90% 60% at 50% 24%,
        black 0%,
        black 30%,
        transparent 78%
      );
      mask-image: radial-gradient(
        ellipse 90% 60% at 50% 24%,
        black 0%,
        black 30%,
        transparent 78%
      );
    }

    .voxel-scene.ready {
      opacity: 0.65;
    }
  }
</style>

<script>
  import * as THREE from "three";

  const sceneEl = document.querySelector<HTMLElement>(".voxel-scene");
  const mount = document.getElementById("cluster-mount");

  if (sceneEl && mount) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    try {
      boot(reduced, sceneEl, mount);
    } catch {
      sceneEl.style.display = "none";
    }
  }

  function mulberry32(seed: number) {
    return () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function hash2(x: number, y: number, seed: number) {
    const s = Math.sin(x * 127.1 + y * 311.7 + seed * 0.017) * 43758.5453;
    return s - Math.floor(s);
  }

  function valueNoise(x: number, y: number, seed: number) {
    const xi = Math.floor(x);
    const yi = Math.floor(y);
    const xf = x - xi;
    const yf = y - yi;
    const u = xf * xf * (3 - 2 * xf);
    const v = yf * yf * (3 - 2 * yf);
    const a = hash2(xi, yi, seed);
    const b = hash2(xi + 1, yi, seed);
    const c = hash2(xi, yi + 1, seed);
    const d = hash2(xi + 1, yi + 1, seed);
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
  }

  type Inst = {
    px: number; py: number; pz: number;
    sx: number; sy: number; sz: number;
    dx: number; dz: number;
    spread: number; fall: number;
    delay: number; dur: number;
    hex: number;
  };

  function boot(reduced: boolean, sceneEl: HTMLElement, mount: HTMLElement) {
    const SEED = 20260823;
    const isMobile = window.innerWidth < 640;
    const isTiny = window.innerWidth < 380;
    const GRID = isTiny ? 7 : isMobile ? 9 : 11;
    const STEP = isTiny ? 1.08 : 1.16;

    const rand = mulberry32(SEED);

    const cA = new THREE.Color();
    const cB = new THREE.Color();
    const ramp = (a: string, b: string, t: number) => cA.set(a).lerp(cB.set(b), t).getHex();

    const instances: Inst[] = [];
    {
      const half = (GRID - 1) / 2;
      for (let gz = 0; gz < GRID; gz++) {
        for (let gx = 0; gx < GRID; gx++) {
          const cx = gx - half;
          const cz = gz - half;
          const dc = Math.hypot(cx, cz) / (half + 0.6);
          const falloff = Math.max(0, 1 - dc * dc * 1.35);
          if (falloff <= 0.02) continue;
          if (rand() > falloff * 1.25 - 0.08) continue;

          const n =
            valueNoise(gx * 0.42, gz * 0.42, SEED) * 0.65 +
            valueNoise(gx * 0.97 + 13, gz * 0.97 + 29, SEED + 7) * 0.35;
          const h = Math.max(1, Math.round((0.5 + n * 3.4) * falloff));
          const roll = rand();
          const tier = roll < 0.06 ? 1 : roll < 0.125 ? 2 : 0;

          const wx = cx * STEP;
          const wz = cz * STEP;
          const coreDist = Math.hypot(wx, wz);

          const ang = rand() * Math.PI * 2;
          const outR = 9 + rand() * 14;
          const base = {
            sx: wx + Math.cos(ang) * outR,
            sy: (rand() - 0.2) * 10,
            sz: wz + Math.sin(ang) * outR * 0.7,
            dx: Math.cos(ang),
            dz: Math.sin(ang) * 0.6,
            spread: 7 + rand() * 9,
            fall: 5 + rand() * 8,
            delay: coreDist * 90 + rand() * 240,
            dur: 720 + rand() * 380,
          };

          for (let iy = 0; iy < h; iy++) {
            const f = h === 1 ? 1 : iy / (h - 1);
            const hex =
              iy === h - 1 && tier
                ? tier === 1
                  ? ramp("#8a6a30", "#dfa94a", f)
                  : ramp("#27423d", "#67b7aa", f)
                : ramp("#151921", "#37404b", f);
            instances.push({ px: wx, py: iy * STEP, pz: wz, hex, ...base });
          }

          const depth = Math.floor(
            (valueNoise(gx * 0.57 + 41, gz * 0.57 + 23, SEED + 3) * 2.6 * falloff)
          );
          for (let d = 1; d <= depth; d++) {
            instances.push({
              px: wx,
              py: -d * STEP,
              pz: wz,
              hex: ramp("#0e1116", "#181d24", rand()),
              ...base,
            });
          }
        }
      }
    }

    const isCoarse = window.matchMedia("(pointer: coarse)").matches;
    const renderer = new THREE.WebGLRenderer({ antialias: !isMobile && !isCoarse, alpha: true, powerPreference: isMobile ? "low-power" : "high-performance" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, isMobile ? 1 : 2));
    renderer.setClearColor(0x000000, 0);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    mount.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 120);

    scene.add(new THREE.AmbientLight(0xc2cad6, 0.85));
    const key = new THREE.DirectionalLight(0xffd9a3, 2.6);
    key.position.set(7, 11, 5);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0x66d0c2, 1.6);
    rim.position.set(-8, 4, -7);
    scene.add(rim);

    const pivot = new THREE.Group();
    const cluster = new THREE.Group();
    pivot.add(cluster);
    scene.add(pivot);

    const geometry = new THREE.BoxGeometry(STEP * 0.94, STEP * 0.94, STEP * 0.94);
    const material = new THREE.MeshStandardMaterial({ roughness: 0.82, metalness: 0.08 });
    const mesh = new THREE.InstancedMesh(geometry, material, instances.length);
    mesh.frustumCulled = false;
    mesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);

    const dummy = new THREE.Object3D();
    const tmpColor = new THREE.Color();
    instances.forEach((inst, i) => {
      dummy.position.set(inst.px, inst.py, inst.pz);
      dummy.scale.setScalar(1);
      dummy.updateMatrix();
      mesh.setMatrixAt(i, dummy.matrix);
      mesh.setColorAt(i, tmpColor.setHex(inst.hex));
    });
    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
    cluster.add(mesh);

    const BASE_THETA = 0.68;
    const BASE_PHI = 1.03;
    const RADIUS = 30;
    const TARGET = new THREE.Vector3(0, 1.3, 0);

    let theta = BASE_THETA;
    let phi = BASE_PHI;
    let nx = 0, ny = 0, smx = 0, smy = 0;
    let scrollP = 0;
    let heroTop = 0;
    let heroHeight = 1;
    let dissolvedOnce = false;
    let appliedFade = -1;

    const entranceStart = reduced ? 0 : performance.now();
    let entranceDone = reduced;
    const entranceTotal = instances.reduce((m, i) => Math.max(m, i.delay + i.dur), 0);

    function placeCamera() {
      camera.position.set(
        TARGET.x + Math.sin(phi) * Math.sin(theta) * RADIUS,
        TARGET.y + Math.cos(phi) * RADIUS,
        TARGET.z + Math.sin(phi) * Math.cos(theta) * RADIUS
      );
      camera.lookAt(TARGET);
    }

    function setFinalMatrices() {
      instances.forEach((inst, i) => {
        dummy.position.set(inst.px, inst.py, inst.pz);
        dummy.scale.setScalar(1);
        dummy.updateMatrix();
        mesh.setMatrixAt(i, dummy.matrix);
      });
      mesh.instanceMatrix.needsUpdate = true;
    }

    function updateMatrices(now: number) {
      if (!entranceDone) {
        const el = now - entranceStart;
        let pending = false;
        instances.forEach((inst, i) => {
          const k = Math.min(1, Math.max(0, (el - inst.delay) / inst.dur));
          if (k < 1) pending = true;
          const e = 1 - Math.pow(1 - k, 3);
          dummy.position.set(
            inst.sx + (inst.px - inst.sx) * e,
            inst.sy + (inst.py - inst.sy) * e,
            inst.sz + (inst.pz - inst.sz) * e
          );
          dummy.scale.setScalar(Math.max(e, 0.001));
          dummy.updateMatrix();
          mesh.setMatrixAt(i, dummy.matrix);
        });
        mesh.instanceMatrix.needsUpdate = true;
        if (!pending) {
          entranceDone = true;
          setFinalMatrices();
        }
        return;
      }

      if (scrollP > 0) {
        const e = scrollP * scrollP;
        instances.forEach((inst, i) => {
          dummy.position.set(
            inst.px + inst.dx * inst.spread * e,
            inst.py - inst.fall * e,
            inst.pz + inst.dz * inst.spread * e
          );
          dummy.scale.setScalar(1 - e * 0.35);
          dummy.updateMatrix();
          mesh.setMatrixAt(i, dummy.matrix);
        });
        mesh.instanceMatrix.needsUpdate = true;
        dissolvedOnce = true;
      } else if (dissolvedOnce) {
        setFinalMatrices();
        dissolvedOnce = false;
      }
    }

    let lastW = -1;
    let lastH = -1;

    function layout() {
      const w = mount.clientWidth || 1;
      const h = mount.clientHeight || 1;
      if (w === lastW && h === lastH) return;
      lastW = w;
      lastH = h;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();

      const wide = w >= 900;
      const visW = 2 * Math.tan((camera.fov * Math.PI) / 360) * RADIUS * camera.aspect;
      pivot.position.x = wide ? visW * 0.235 : 0;
      pivot.scale.setScalar(wide ? 1 : w < 560 ? 0.74 : 0.88);
      measure();
    }

    function measure() {
      const rect = mount.getBoundingClientRect();
      heroTop = rect.top + window.scrollY;
      heroHeight = rect.height || 1;
      recalcScroll();
    }

    function recalcScroll() {
      scrollP = Math.min(
        1,
        Math.max(0, (window.scrollY - heroTop) / (heroHeight * 0.8))
      );
    }

    let inView = true;
    let running = false;
    let rafId = 0;

    function draw(now: number) {
      const t = now / 1000;

      smx += (nx - smx) * 0.05;
      smy += (ny - smy) * 0.05;
      theta = BASE_THETA + smx * 0.18 + scrollP * 0.25;
      phi = BASE_PHI - smy * 0.1;
      placeCamera();

      cluster.rotation.y = t * 0.07 + scrollP * 1.2;
      cluster.position.y = Math.sin(t * 0.55) * 0.3;

      updateMatrices(now);

      const fade = 1 - Math.min(1, scrollP * 1.12) * 0.94;
      if (fade !== appliedFade) {
        appliedFade = fade;
        mount.style.opacity = fade.toFixed(3);
      }

      renderer.render(scene, camera);
    }

    function frame(now: number) {
      if (!running) return;
      draw(now);
      rafId = requestAnimationFrame(frame);
    }

    function syncLoop() {
      const want = !reduced && inView;
      if (want && !running) {
        running = true;
        rafId = requestAnimationFrame(frame);
      } else if (!want && running) {
        running = false;
        cancelAnimationFrame(rafId);
      }
    }

    function renderOnce() {
      theta = BASE_THETA;
      phi = BASE_PHI;
      placeCamera();
      renderer.render(scene, camera);
    }

    layout();

    const ro = new ResizeObserver(() => {
      layout();
      if (reduced) renderOnce();
    });
    ro.observe(mount);

    if (reduced) {
      renderOnce();
    } else {
      window.addEventListener("scroll", recalcScroll, { passive: true });
      if (!isMobile && !isCoarse) {
        window.addEventListener(
          "pointermove",
          (e) => {
            nx = (e.clientX / window.innerWidth) * 2 - 1;
            ny = (e.clientY / window.innerHeight) * 2 - 1;
          },
          { passive: true }
        );
      }

      new IntersectionObserver((entries) => {
        const entry = entries[0];
        if (!entry) return;
        inView = entry.isIntersecting;
        syncLoop();
      }).observe(mount);

      setTimeout(() => {
        if (performance.now() - entranceStart > entranceTotal) entranceDone = true;
        draw(performance.now());
        syncLoop();
      }, 60);
    }

    sceneEl.classList.add("ready");
  }
</script>
